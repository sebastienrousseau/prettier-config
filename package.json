{
  "name": "@sebastienrousseau/prettier-config",
  "version": "0.0.7",
  "description": "Shareable Prettier configuration rules adhering to modern formatting standards",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/prettier-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/prettier-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/prettier-config/issues"
  },
  "keywords": [
    "prettier",
    "prettierconfig",
    "code-formatter",
    "style-guide"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "prettier-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/conformance.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh",
    "test:conformance": "node --test tests/conformance.test.js",
    "fuzz": "node fuzz/fuzz_config.js"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "devDependencies": {
    "@sebastienrousseau/config-kit": "^0.0.8",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "configKit": {
    "shape": "object",
    "presets": [],
    "validate": "prettier"
  }
}
